# Server-side only. Never prefix any of these with VITE_ (that would expose them to the browser).

# LIVE switch. Anything other than exactly "true" keeps every request in MOCK.
QLOO_LIVE_ENABLED=false
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Private test access to /api/live: SHA-256 hex of the token (npm run live:token). Comma-separate several.
LIVE_ACCESS_TOKEN_SHA256=
LIVE_MAX_ANALYSES_PER_HOUR=20

# Per-request Qloo limits (defaults shown).
QLOO_MAX_CALLS_PER_ANALYSIS=80
QLOO_MAX_CALLS_PER_DIAGNOSTIC=150
QLOO_CONCURRENCY=6
QLOO_TIMEOUT_MS=8000
QLOO_DEADLINE_MS=45000

# Optional: 0 disables live Wikipedia/Wikidata lookups for guests without a stored profile.
PROFILE_LOOKUP=

# PUBLIC Qloo LIVE (/api/discover, no token). Independent of QLOO_LIVE_ENABLED; off unless exactly "true".
# Limits are shared by every function instance (Netlify Blobs, atomic writes). Defaults shown.
QLOO_PUBLIC_ENABLED=false
# Hard ceiling of Qloo network calls per UTC day for the public path (each fresh analysis reserves its cap first).
PUBLIC_DAILY_QLOO_CALLS=400
# Hard cap of Qloo calls per public analysis (retries included). The full call plan fits in 80.
PUBLIC_CALLS_PER_ANALYSIS=80
PUBLIC_MAX_CONCURRENT=2
PUBLIC_FRESH_PER_IP_PER_DAY=3
PUBLIC_OPEN_FEEDS_PER_DAY=10
PUBLIC_CACHE_HOURS=24
# Results that lost some Qloo answers are cached this long, labeled partial (0 = never cache them).
PUBLIC_PARTIAL_CACHE_HOURS=1
# Wall-clock budget of one background analysis (seconds, 60–840).
PUBLIC_JOB_MAX_SECONDS=240
# Qloo proposals verified in Wikidata/Wikipedia per public analysis (1–30).
PUBLIC_EXTERNAL_VERIFY_MAX=24
# Optional salt for the pseudonymous visitor hash (IPs are never stored raw).
PUBLIC_IP_SALT=
