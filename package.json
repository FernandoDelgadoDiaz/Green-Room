    "test": "vitest run",
    "data:build": "tsx scripts/build-dataset.ts",
    "backtest": "tsx scripts/run-backtest.ts",
    "qloo:smoke": "tsx scripts/qloo-smoke.ts",
    "profiles:build": "tsx scripts/build-profiles.ts"
  },
  "devDependencies": {
